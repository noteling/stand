# Copy this file to .env and fill in at least one key. .env is never committed.

# Google AI Studio key, for Gemini 3.8 Live
GEMINI_API_KEY=

# OpenAI key, for GPT-Live-1 (needs a paid account)
OPENAI_API_KEY=

# Anthropic key, for the brain (the model that looks things up in context/).
# Leave it empty to use the Claude Code CLI's own login instead. See brain.json.
ANTHROPIC_API_KEY=

# A secret for your own gateway, if brain.json names one in apiHeaders as "$GATEWAY_TOKEN"
# GATEWAY_TOKEN=

# A token for a private GitHub repository that brain.json lists under "sources" with "token": "$HANDBOOK_TOKEN".
# Make it fine-grained, for that one repository, with Contents: Read-only.
# HANDBOOK_TOKEN=

# Optional settings
# STAND_CONTEXT=poc/heckler/context   # for a test run: this folder is the only notes
# STAND_BRAIN=poc/heckler/sources-brain.json   # for a test run: read the brain's settings from this file, not brain.json
# GEMINI_LIVE_MODEL=gemini-3.8-live
# GEMINI_VOICE=Kore
# GEMINI_START_SENSITIVITY=low    # low or high: how readily Gemini decides someone started speaking
# GEMINI_PREFIX_PADDING_MS=500    # how long a sound must last before Gemini counts it as speech
# OPENAI_LIVE_MODEL=gpt-live-1
# OPENAI_VOICE=marin
# CONTINUE_AFTER_MS=1200          # pause after Stand's own turn before "carry on", for a model that does not report its turn finished; 0 turns carry-on off
# NUDGE_AFTER_MS=8000             # the same, after a silence the room left unfilled; 0 turns it off
# ROOM_VOICE_RMS=500              # loudness above which the room counts as making sound
# PORT=5177
